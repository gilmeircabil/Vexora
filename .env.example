# ==========================================
# ToolNest — Environment Configuration
# ==========================================

# Server Environment & Port
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Database (MongoDB connection URI)
MONGODB_URI=mongodb://127.0.0.1:27017/toolnest

# JWT Authentication Secrets (Must be at least 32 characters in production)
JWT_SECRET=toolnest_production_jwt_secret_must_be_at_least_32_characters_long
JWT_REFRESH_SECRET=toolnest_production_jwt_refresh_secret_must_be_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Initial Administrator Credentials (Auto-seeded on first server boot)
ADMIN_EMAIL=admin@toolnest.local
ADMIN_PASSWORD=Admin123!Secure

# Payment Provider Configuration ('sandbox' | 'stripe' | 'paymongo')
PAYMENT_PROVIDER=sandbox

# Stripe Credentials (Required if PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# PayMongo Credentials (Required if PAYMENT_PROVIDER=paymongo for PH/SEA merchants)
PAYMONGO_SECRET_KEY=sk_test_...
PAYMONGO_WEBHOOK_SECRET=whsec_...

# Optional Python FastAPI AI Microservice URL (e.g. for PyTorch / BiRefNet / Real-ESRGAN)
FASTAPI_AI_URL=

# Configurable Plan Pricing Overrides (Defaults apply if omitted)
# Currency: USD or PHP depending on merchant
PLAN_PRO_MONTHLY_PRICE=9.99
PLAN_PRO_YEARLY_PRICE=99.00
PLAN_PRO_MONTHLY_CREDITS=300

PLAN_PREMIUM_MONTHLY_PRICE=24.99
PLAN_PREMIUM_YEARLY_PRICE=249.00
PLAN_PREMIUM_MONTHLY_CREDITS=1000
