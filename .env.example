# ==========================================
# VexoraMods — Environment Configuration Template
# ==========================================

# Server Environment & Port
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Database (MongoDB Connection URI)
MONGODB_URI=mongodb://127.0.0.1:27017/vexoramods

# JWT Authentication Secrets (Must be at least 32 characters in production)
JWT_SECRET=your_super_secret_jwt_access_key_min_32_characters_long
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_characters_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Initial Administrator Credentials (Auto-seeded on first server boot)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!Secure

# Bot & Spam Protection (Cloudflare Turnstile keys)
# Testing keys always pass:
# Site Key: 1x00000000000000000000AA | Secret Key: 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# File & Asset Storage Provider ('local' | 's3' e.g. Cloudflare R2 / AWS S3)
STORAGE_PROVIDER=local
STORAGE_MAX_GB=9.5
S3_BUCKET=vexora-assets
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# AI Microservice & Free Cloud LLM Providers ('auto' | 'gemini' | 'nvidia' | 'ollama')
FASTAPI_AI_URL=http://127.0.0.1:8000
FASTAPI_AI_SECRET=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c
AI_PROVIDER=auto

# Google Gemini (Free via https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# NVIDIA NIM (1,000 Free Credits via https://build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# OpenRouter (Free & Multi-Provider via https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

# Groq LPU Ultra-Fast Inference (via https://console.groq.com)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Local Ollama Fallback (Optional)
OLLAMA_URL=http://127.0.0.1:11434

# =============================================================================
# Google OAuth 2.0 (100% Free - Optional)
# =============================================================================
# Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/oauth/google/callback
VITE_GOOGLE_CLIENT_ID=

